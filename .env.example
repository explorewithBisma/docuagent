# Copy this file to .env and fill in your own values. Never commit .env.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=qwen/qwen3.8-27b
# SQLite locally; a Postgres URL (e.g. from Neon) in production
DATABASE_URL=sqlite:///./docuagent.db
GROQ_MAX_TOKENS=1000
# Who is asked first; the next one is the fallback
LLM_PROVIDER_ORDER=groq,gemini
# Text model with tool calling for the Agent page (separate from the vision GROQ_MODEL)
AGENT_MODEL=openai/gpt-oss-20b
# Web pages allowed to call the API from a browser (the React dev server). Comma-separated exact origins, never "*"
CORS_ORIGINS=http://localhost:5173
